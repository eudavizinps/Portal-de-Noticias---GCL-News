{
  "name": "gcl-radar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --port 8787 --local",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply gcl-radar-db --local",
    "db:remote": "wrangler d1 migrations apply gcl-radar-db --remote",
    "test": "node --test tests/*.mjs",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.3",
    "hono": "^4.11.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.50.0"
  }
}
